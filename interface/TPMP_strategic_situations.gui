guiTypes = {

	# Thin tab hanging from the bottom edge of the top bar, under the flag. Attached to the top bar by the scripted GUI.
	containerWindowType = {
		name = "TPMP_strat_topbar_tab_window"
		position = { x = 7 y = 79 }
		size = { width = 92 height = 20 }
		clipping = no

		buttonType = {
			name = "TPMP_strat_open_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_TPMP_strat_topbar_tab_open"
			clicksound = click_close # same pair of sounds as the vanilla top bar tabs
			oversound = ui_menu_over
			pdx_tooltip = "TPMP_strat_topbar_tab_open_tt"
			pdx_tooltip_delayed = "TPMP_strat_topbar_tab_open_tt_delayed"
		}

		buttonType = {
			name = "TPMP_strat_close_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_TPMP_strat_topbar_tab_close"
			clicksound = click_close # same pair of sounds as the vanilla top bar tabs
			oversound = ui_menu_over
			pdx_tooltip = "TPMP_strat_topbar_tab_close_tt"
			pdx_tooltip_delayed = "TPMP_strat_topbar_tab_close_tt_delayed"
		}
	}

	# The Strategic Situations panel
	containerWindowType = {
		name = "TPMP_strat_window"
		position = { x = -425 y = -371 }
		size = { width = 850 height = 742 }
		orientation = center
		moveable = yes
		click_to_front = yes
		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_plain_bg"
		}

		iconType = {
			name = "TPMP_strat_header_bg"
			spriteType = "GFX_TPMP_strat_header_bg"
			position = { x = 5 y = 7 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "TPMP_strat_title"
			position = { x = 45 y = 8 }
			font = "hoi_36header"
			borderSize = { x = 0 y = 0 }
			text = "TPMP_strat_title"
			maxWidth = 700
			maxHeight = 20
			format = left
		}

		buttonType = {
			name = "TPMP_strat_window_close_button"
			position = { x = -46 y = 10 }
			quadTextureSprite = "GFX_closebutton"
			buttonFont = "hoi_16mbs"
			shortcut = "ESCAPE"
			Orientation = "UPPER_RIGHT"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		# Front selection. Frame 1 is the selected look, frame 2 the idle look (same convention as the vanilla research tabs).
		# Declared before the body so the body frame draws over the bottom of the tabs and they read as part of it.
		containerWindowType = {
			name = "TPMP_strat_tabs"
			position = { x = 5 y = 50 }
			size = { width = 840 height = 34 }

			buttonType = {
				name = "TPMP_strat_tab_1"
				position = { x = 0 y = 0 }
				quadTextureSprite = "GFX_tab_medium"
				text = "TPMP_strat_tab_eastern"
				buttonFont = "hoi_18mbs"
				frame = 1
				clicksound = click_default
			}

			buttonType = {
				name = "TPMP_strat_tab_2"
				position = { x = 210 y = 0 }
				quadTextureSprite = "GFX_tab_medium"
				text = "TPMP_strat_tab_western"
				buttonFont = "hoi_18mbs"
				frame = 2
				clicksound = click_default
			}

			buttonType = {
				name = "TPMP_strat_tab_3"
				position = { x = 420 y = 0 }
				quadTextureSprite = "GFX_tab_medium"
				text = "TPMP_strat_tab_mediterranean"
				buttonFont = "hoi_18mbs"
				frame = 2
				clicksound = click_default
			}

			buttonType = {
				name = "TPMP_strat_tab_4"
				position = { x = 630 y = 0 }
				quadTextureSprite = "GFX_tab_medium"
				text = "TPMP_strat_tab_pacific"
				buttonFont = "hoi_18mbs"
				frame = 2
				clicksound = click_default
			}
		}

